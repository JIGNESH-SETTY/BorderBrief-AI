# BorderBrief AI — Environment Variables Example
# Copy this file to .env.local and configure your keys for local development.
# IMPORTANT: .env.local is ignored by git and must NEVER be committed.

# Google AI Studio Gemini API Key (Optional for local testing; demo mode active if absent)
# Get a free key at: https://aistudio.google.com/app/apikey
# Free tier operates at ₹0 cost without credit card on supported models (e.g., gemini-3.8-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Active Gemini Model (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Environment Mode
NODE_ENV=development

# PayPal Sandbox API Configuration (Sprint 6 - ₹0 Development Budget)
# Obtain free Sandbox credentials from PayPal Developer Portal: https://developer.paypal.com/dashboard/applications/sandbox
# SECURITY: Never expose PAYPAL_CLIENT_SECRET through NEXT_PUBLIC_ variables or commit real credentials.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here


